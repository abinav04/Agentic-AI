# Kestrel Multi-Agent Research Assistant - Environment Configuration

# LLM Provider Configuration
GROQ_API_KEY=
GEMINI_API_KEY=

# Model Overrides (Optional - defaults provided in app/config.py)
GROQ_MODEL=groq/compound-mini
GEMINI_MODEL=gemini-3.6-flash

# Provider Selection & Failover Settings
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_ENABLED=true

# Embedding Model (Local - sentence-transformers)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=./chroma_db

# LangSmith Observability Configuration
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kestrel-research-assistant
LANGSMITH_TRACING_V2=true

# Server & UI Settings
PORT=8000
HOST=0.0.0.0
FASTAPI_URL=http://localhost:8000
